{
  "name": "payout-invariance-kit",
  "version": "0.1.0",
  "description": "Prove a ranking/recommendation/comparison engine's output does not change based on which option pays the operator more — a runtime mutation check plus a static import check, both framework-agnostic.",
  "keywords": [
    "affiliate-neutrality",
    "ranking",
    "recommendation-engine",
    "testing",
    "honesty",
    "property-testing",
    "vitest"
  ],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/payout-invariance-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/payout-invariance-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/payout-invariance-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
