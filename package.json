{
  "name": "payout-invariance",
  "version": "0.1.0",
  "description": "Prove a ranking/recommendation/comparison engine's output does not change based on which option pays the operator more — a runtime mutation check plus a static import check, both framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "affiliate-neutrality",
    "ranking",
    "recommendation-engine",
    "testing",
    "honesty",
    "property-testing",
    "vitest"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
